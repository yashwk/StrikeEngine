{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StrikeEngine Seeker Profile Schema",
  "description": "Flat snake_case SeekerConfig schema loaded by SeekerProfileDatabase (data/seekers/*.json).",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": ["none", "rf", "ir", "passive_rf", "sarh"]
    },
    "transmitter_power_w": { "type": "number", "minimum": 0 },
    "antenna_gain_db": { "type": "number" },
    "wavelength_m": { "type": "number", "minimum": 0 },
    "noise_floor_w": { "type": "number", "minimum": 0 },
    "snr_threshold_db": { "type": "number" },
    "sensitivity_w": { "type": "number", "minimum": 0 },
    "wavelength_band": { "type": "integer" },
    "ir_extinction_per_m": { "type": "number", "minimum": 0 },
    "illuminator_px": { "type": "number" },
    "illuminator_py": { "type": "number" },
    "illuminator_pz": { "type": "number" },
    "illuminator_power_w": { "type": "number", "minimum": 0 },
    "illuminator_gain_db": { "type": "number" },
    "illuminator_wavelength_m": { "type": "number", "minimum": 0 },
    "field_of_view_half_angle_rad": { "type": "number", "minimum": 0 },
    "gimbal_azimuth_limit_rad": { "type": "number", "minimum": 0 },
    "gimbal_elevation_limit_rad": { "type": "number", "minimum": 0 },
    "lock_hysteresis_db": { "type": "number", "minimum": 0 },
    "lock_dropout_time_sec": { "type": "number", "minimum": 0 },
    "measurement_latency_sec": { "type": "number", "minimum": 0 }
  },
  "required": ["type"]
}
